---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import draPatricia from '../assets/photos/dra-patricia-clinica.jpg';
import drRoberto from '../assets/photos/dr-especialista.jpg';
import draClaudia from '../assets/photos/dra-claudia.jpg';
import tooth from '../assets/brand/tooth.svg?raw';
import { waLink } from '../data/clinica';
import { useT, asLocale } from '../i18n';

const t = useT(asLocale(Astro.currentLocale));

const fotos: Record<string, ImageMetadata> = {
  'dra-patricia-clinica': draPatricia,
  'dr-roberto': drRoberto,
  'dra-claudia': draClaudia,
};

const [fundadora, ...especialistas] = t.equipo.miembros;
const credenciales = [
  { label: t.equipo.formacionLabel, valor: fundadora.formacion, icono: 'M4 9l8-4 8 4-8 4-8-4Z M6 10.5V15c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.5 M20 9v5' },
  { label: t.equipo.experienciaLabel, valor: fundadora.experiencia, icono: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z M12 7v5l3 2' },
  { label: t.equipo.enfoqueLabel, valor: fundadora.enfoque, icono: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z M12 16.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Z M12 12h.01' },
];
---

<section id="equipo" class="relative scroll-mt-24 overflow-hidden">
  <!-- Marca de agua del diente: lado izquierdo (en Nosotros va a la derecha) -->
  <div class="tooth-mark -left-20 top-28 -scale-x-100" set:html={tooth} data-parallax-slow />
  <div class="pointer-events-none absolute -right-24 top-1/3 size-[26rem] rounded-full bg-aqua-300/20 blur-[120px] dark:bg-aqua-300/10"></div>

  <div class="relative mx-auto max-w-6xl px-5 py-16 sm:py-24 lg:px-8 lg:py-32">
    <div class="max-w-2xl">
      <p class="eyebrow" data-reveal>{t.equipo.eyebrow}</p>
      <h2 class="display mt-4 text-[clamp(2rem,4.5vw,3.2rem)]" data-split set:html={t.equipo.titulo} />
      <p class="mt-5 text-lg text-ink-soft" data-reveal>{t.equipo.sub}</p>
    </div>

    <!-- ── Fundadora: tarjeta editorial destacada ── -->
    <div class="spot-grid mt-12 lg:mt-16">
      <article class="spot rounded-[2rem]" data-reveal data-spot data-tilt="2.5">
        <div class="spot-inner grid rounded-[calc(2rem-1.5px)] lg:grid-cols-[0.9fr_1.1fr]">
          <div class="relative overflow-hidden max-lg:aspect-[4/3.4] lg:min-h-[34rem]">
            <Image
              src={fotos[fundadora.foto]}
              alt={`${fundadora.nombre} — ${fundadora.cargo}`}
              class="founder-img absolute inset-0 size-full object-cover object-top"
              widths={[600, 900, 1200]}
              sizes="(min-width: 1024px) 32rem, 100vw"
            />
            <div class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-deep/70 to-transparent"></div>
            <span class="glass absolute left-5 top-5 inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-semibold text-white">
              <span class="size-1.5 rounded-full bg-aqua-300"></span>
              {t.equipo.fundadora}
            </span>
            <div class="absolute inset-x-5 bottom-5 text-white lg:hidden">
              <p class="font-display text-2xl font-medium leading-tight">{fundadora.nombre}</p>
              <p class="mt-1 text-sm text-aqua-300">{fundadora.cargo}</p>
            </div>
          </div>

          <div class="flex flex-col p-7 sm:p-9 lg:p-11">
            <div class="max-lg:hidden">
              <h3 class="font-display text-[2rem] font-medium leading-tight">{fundadora.nombre}</h3>
              <p class="mt-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-teal-500 dark:text-aqua-300">{fundadora.cargo}</p>
            </div>

            <blockquote class="relative mt-5 lg:mt-7">
              <svg class="absolute -left-1 -top-3 size-9 text-aqua-300/60" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.2 17.5c-1.8 0-3.2-1.5-3.2-3.5 0-3.6 2.4-6.6 6-8l.6 1.2c-2 .9-3.3 2.5-3.6 4.3.3-.1.6-.2 1-.2 1.7 0 3 1.3 3 3.1 0 1.8-1.6 3.1-3.8 3.1Zm9.5 0c-1.8 0-3.2-1.5-3.2-3.5 0-3.6 2.4-6.6 6-8l.6 1.2c-2 .9-3.3 2.5-3.6 4.3.3-.1.6-.2 1-.2 1.7 0 3 1.3 3 3.1 0 1.8-1.6 3.1-3.8 3.1Z"/></svg>
              <p class="founder-quote relative pl-8 font-display text-[1.35rem] font-medium italic leading-snug text-ink sm:text-2xl">{fundadora.cita}</p>
            </blockquote>

            <p class="mt-6 leading-relaxed text-ink-soft">{fundadora.bio}</p>

            <dl class="mt-7 grid gap-4 sm:grid-cols-3">
              {
                credenciales.map((c) => (
                  <div class="rounded-2xl bg-ice p-4">
                    <dt class="flex items-center gap-2 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-teal-500 dark:text-aqua-300">
                      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d={c.icono} />
                      </svg>
                      {c.label}
                    </dt>
                    <dd class="mt-2 text-sm font-medium leading-snug">{c.valor}</dd>
                  </div>
                ))
              }
            </dl>

            <div class="mt-auto flex flex-wrap items-center gap-3 pt-8">
              <a href={waLink(t.whatsapp.doctor(fundadora.nombre))} target="_blank" rel="noopener" class="btn btn-dark !px-6 !py-3.5 !text-sm">
                <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.4 14.1c-.2.7-1.3 1.3-1.9 1.4-.5.1-1.1.1-1.8-.1a16 16 0 0 1-1.6-.6c-2.8-1.2-4.7-4.1-4.8-4.3-.1-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.2-.3.5-.4.7-.4h.5c.2 0 .4 0 .6.4l.9 2.2c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.1.3.7 1.2 1.6 1.9 1.1 1 2 1.3 2.3 1.4.3.1.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l2 .9c.3.2.5.3.6.4 0 .2 0 .7-.2 1.1Z"/></svg>
                {t.equipo.agendarCon} {fundadora.corto}
              </a>
              <ul class="flex flex-wrap gap-2">
                {fundadora.especialidades.map((e) => <li class="spot-chip rounded-full px-3 py-1 text-xs font-semibold">{e}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </article>
    </div>

    <!-- ── Especialistas ── -->
    <p class="eyebrow mt-14 lg:mt-20" data-reveal>{t.equipo.especialistasEyebrow}</p>
    <div class="spot-grid mt-6 grid gap-5 md:grid-cols-2 lg:gap-6">
      {
        especialistas.map((d, i) => (
          <article class="spot rounded-3xl" data-reveal data-delay={String(0.1 + i * 0.12)} data-spot data-tilt="4">
            <div class="spot-inner flex h-full flex-col rounded-[calc(1.5rem-1.5px)]">
              <div class="member-img relative aspect-[4/3.3] overflow-hidden">
                <Image
                  src={fotos[d.foto]}
                  alt={`${d.nombre} — ${d.cargo}`}
                  class="size-full object-cover object-[50%_18%] transition-transform duration-[1.2s] ease-[cubic-bezier(0.16,1,0.3,1)]"
                  widths={[500, 800]}
                  sizes="(min-width: 768px) 34rem, 100vw"
                />
                <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-deep/75 to-transparent" />
                <div class="absolute inset-x-5 bottom-5 text-white">
                  <h3 class="font-display text-2xl font-medium leading-tight">{d.nombre}</h3>
                  <p class="mt-1 text-sm text-aqua-300">{d.cargo}</p>
                </div>
              </div>
              <div class="flex flex-1 flex-col p-6 sm:p-7">
                <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-teal-500 dark:text-aqua-300">
                  <span class="h-px w-5 bg-aqua-300" />
                  {d.enfoque}
                </p>
                <p class="mt-3 leading-relaxed text-ink-soft">{d.bio}</p>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {d.especialidades.map((e) => <li class="spot-chip rounded-full px-3 py-1 text-xs font-semibold">{e}</li>)}
                </ul>
                <a href={waLink(t.whatsapp.doctor(d.nombre))} target="_blank" rel="noopener" class="member-cta mt-auto inline-flex items-center gap-2 pt-6 text-sm font-semibold text-teal-900 dark:text-aqua-300">
                  {t.equipo.agendarCon} {d.corto}
                  <svg class="size-4 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .founder-img {
    transition: transform 1.4s var(--ease-out-expo);
  }
  .spot:hover .founder-img {
    transform: scale(1.04);
  }
  .spot:hover .member-img img {
    transform: scale(1.06);
  }
  .member-cta:hover svg {
    transform: translateX(4px);
  }
  .founder-quote {
    font-variation-settings: 'opsz' 72, 'SOFT' 60;
  }
</style>

<script>
  import { initSpotlight } from '../scripts/spotlight';
  const seccion = document.getElementById('equipo');
  if (seccion) initSpotlight(seccion);
</script>
