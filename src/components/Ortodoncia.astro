---
import { waLink } from '../data/clinica';
import { useT, asLocale } from '../i18n';

const t = useT(asLocale(Astro.currentLocale));
const wa = waLink(t.whatsapp.ortodoncia);
---

<section id="ortodoncia" class="grain relative scroll-mt-24 overflow-hidden bg-deep text-white">
  <div class="absolute inset-0 bg-[radial-gradient(70rem_45rem_at_85%_-10%,#0b7482_0%,transparent_55%)]"></div>

  <div class="relative mx-auto max-w-6xl px-5 py-16 sm:py-24 lg:px-8 lg:py-32">
    <div class="max-w-2xl">
      <p class="eyebrow !text-aqua-300" data-reveal>{t.ortodoncia.eyebrow}</p>
      <h2 class="display mt-4 text-[clamp(2rem,4.5vw,3.2rem)]" data-reveal set:html={t.ortodoncia.titulo} />
      <p class="mt-5 leading-relaxed text-white/70 lg:text-lg" data-reveal>
        {t.ortodoncia.intro}
      </p>
    </div>

    <!-- Tipos de tratamiento -->
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.ortodoncia.tipos.map((tipo, i) => (
          <article class="group rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all duration-500 hover:-translate-y-1.5 hover:border-aqua-300/40" data-reveal data-delay={String(i * 0.08)}>
            <span class="font-mono text-xs tracking-widest text-aqua-300/80">0{i + 1}</span>
            <h3 class="font-display mt-3 text-xl font-medium">{tipo.nombre}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/65 max-sm:line-clamp-4">{tipo.texto}</p>
          </article>
        ))
      }
    </div>

    <!-- Proceso -->
    <div class="mt-16 lg:mt-20">
      <h3 class="font-display text-2xl font-medium" data-reveal>
        {t.ortodoncia.procesoTitulo}
        <em class="font-display italic text-aqua-300">{t.ortodoncia.procesoTituloEm}</em>
      </h3>
      <ol class="mt-8 grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-5">
        {
          t.ortodoncia.proceso.map((p, i) => (
            <li class="relative" data-reveal data-delay={String(i * 0.09)}>
              <div class="flex items-center gap-3">
                <span class="grid size-10 shrink-0 place-items-center rounded-full bg-aqua-300 font-display text-base font-semibold text-teal-900">
                  {i + 1}
                </span>
                <span class="h-px flex-1 bg-white/15 lg:block" aria-hidden="true"></span>
              </div>
              <h4 class="mt-4 font-semibold">{p.titulo}</h4>
              <p class="mt-2 text-sm leading-relaxed text-white/60">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="mt-14 flex flex-wrap items-center gap-5" data-reveal>
      <a href={wa} target="_blank" rel="noopener" class="btn btn-primary max-sm:w-full">{t.ortodoncia.cta}</a>
      <p class="text-sm text-white/55">{t.ortodoncia.nota}</p>
    </div>
  </div>
</section>
