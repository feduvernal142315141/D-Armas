---
import { Image } from 'astro:assets';
import atencion from '../assets/photos/atencion-clinica.jpg';
import gabinete1 from '../assets/photos/gabinete-1.jpg';
import salaEspera from '../assets/photos/sala-espera.jpg';
import recepcion from '../assets/photos/recepcion.jpg';
import gabinete2 from '../assets/photos/gabinete-2.jpg';
import consulta from '../assets/photos/consulta-implantes.jpg';
import claudiaConsulta from '../assets/photos/dra-claudia-consulta.jpg';
import { clinica } from '../data/clinica';
import { useT, asLocale } from '../i18n';

const t = useT(asLocale(Astro.currentLocale));
const g = t.porque.galeria;

// Orden = orden del mosaico y del lightbox. `tile` define la celda del grid.
const fotos = [
  { src: atencion, tile: 'col-span-4 row-span-2', sizes: '(min-width: 1024px) 22rem, 60vw', hero: true },
  { src: gabinete1, tile: 'col-span-2', sizes: '(min-width: 1024px) 11rem, 30vw' },
  { src: salaEspera, tile: 'col-span-2', sizes: '(min-width: 1024px) 11rem, 30vw' },
  { src: recepcion, tile: 'col-span-2', sizes: '(min-width: 1024px) 11rem, 30vw' },
  { src: gabinete2, tile: 'col-span-2', sizes: '(min-width: 1024px) 11rem, 30vw' },
  { src: consulta, tile: 'col-span-2', sizes: '(min-width: 1024px) 11rem, 30vw' },
  // Solo en el visor (el mosaico muestra las 6 primeras)
  { src: claudiaConsulta, tile: null, sizes: '' },
].map((f, i) => ({ ...f, ...g.fotos[i], alt: `${g.fotos[i].titulo} · ${clinica.nombre}` }));

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="porque" class="relative scroll-mt-24 overflow-hidden bg-paper">
  <div class="mx-auto grid max-w-6xl gap-14 px-5 py-16 sm:py-24 lg:grid-cols-2 lg:items-center lg:gap-20 lg:px-8 lg:py-32">
    <!-- ── Mosaico de la clínica ── -->
    <div class="relative">
      <div class="pointer-events-none absolute -left-16 -top-16 -z-10 size-64 rounded-full bg-aqua-300/25 blur-[90px] dark:bg-aqua-300/10"></div>
      <div class="pointer-events-none absolute -bottom-12 -right-10 -z-10 size-56 rounded-full bg-teal-500/15 blur-[80px] dark:bg-teal-500/20"></div>

      <!-- Cada celda lleva el reveal (GSAP escribe transform inline); el botón interior conserva su hover -->
      <div class="grid aspect-[4/5] grid-cols-6 grid-rows-3 gap-2.5 sm:gap-3">
        {
          fotos.map((f, i) => f.tile && (
            <div class:list={['min-h-0', f.tile]} data-reveal data-delay={String(i * 0.08)}>
              <button
                type="button"
                class:list={['tile relative block size-full overflow-hidden rounded-2xl bg-ice text-left shadow-card sm:rounded-3xl', f.hero && 'tile-hero']}
                data-galeria-abrir={String(i)}
                aria-label={`${g.ampliar}: ${f.titulo}`}
              >
                <Image src={f.src} alt={f.alt} class="tile-img size-full object-cover" widths={[320, 560, 900]} sizes={f.sizes} loading="lazy" />
                <span class="tile-shade pointer-events-none absolute inset-0 bg-gradient-to-t from-deep/70 via-deep/10 to-transparent" />
                <span class="tile-cap pointer-events-none absolute inset-x-0 bottom-0 flex items-end justify-between gap-2 p-3 text-white sm:p-4">
                  <span class="min-w-0">
                    <span class="block font-mono text-[0.6rem] tracking-[0.2em] text-aqua-300">{pad(i + 1)}</span>
                    <span class="mt-0.5 block truncate font-display text-sm font-medium leading-tight sm:text-base">{f.titulo}</span>
                  </span>
                  <span class="tile-ico grid size-8 shrink-0 place-items-center rounded-full bg-white/15 backdrop-blur-md">
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M15 3h6v6" /><path d="M9 21H3v-6" /><path d="M21 3l-7 7" /><path d="M3 21l7-7" />
                    </svg>
                  </span>
                </span>
              </button>
            </div>
          ))
        }
      </div>

      <!-- CTA flotante -->
      <div class="absolute bottom-4 left-4 sm:bottom-5 sm:left-5" data-reveal data-delay="0.5">
        <button
          type="button"
          class="ver-todas inline-flex items-center gap-2.5 rounded-full bg-surface/85 py-2.5 pl-3 pr-5 text-sm font-semibold text-ink shadow-lift ring-1 ring-teal-900/10 backdrop-blur-xl dark:ring-white/10"
          data-galeria-abrir="0"
        >
          <span class="grid size-7 place-items-center rounded-full bg-teal-900 text-aqua-300 dark:bg-aqua-300 dark:text-teal-900">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="3" /><circle cx="12" cy="12" r="3.2" /><path d="M8 5l1-2h6l1 2" />
            </svg>
          </span>
          {g.verTodas}
          <span class="font-mono text-xs text-ink-soft">{pad(fotos.length)}</span>
        </button>
      </div>
    </div>

    <!-- ── Texto ── -->
    <div>
      <p class="eyebrow" data-reveal>{t.porque.eyebrow}</p>
      <h2 class="display mt-4 text-[clamp(2rem,4.5vw,3.2rem)]" data-reveal set:html={t.porque.titulo} />
      <p class="mt-5 text-ink-soft" data-reveal>{t.porque.sub}</p>

      <ul class="mt-8 space-y-6">
        {
          t.porque.razones.map((r, i) => (
            <li class="flex gap-4" data-reveal data-delay={String(i * 0.06)}>
              <span class="mt-1 inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-teal-500 text-white">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m5 13 4 4L19 7" />
                </svg>
              </span>
              <div>
                <h3 class="font-semibold">{r.titulo}</h3>
                <p class="mt-1 text-ink-soft max-sm:text-sm">{r.texto}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <!-- Contadores -->
      <dl class="mt-12 grid grid-cols-3 gap-6 border-t border-teal-900/10 pt-8 dark:border-white/10">
        {
          clinica.stats.map((s, i) => (
            <div data-reveal>
              <dt class="sr-only">{t.porque.statsLabels[i]}</dt>
              <dd class="font-display text-4xl font-medium text-teal-900 dark:text-aqua-300">
                <span data-counter={String(s.valor)}>0</span>{s.sufijo}
              </dd>
              <p class="mt-1 text-sm text-ink-soft">{t.porque.statsLabels[i]}</p>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<!-- ── Lightbox ── -->
<dialog id="galeria" class="galeria" closedby="any" aria-label={g.aria} data-lenis-prevent>
  <div class="galeria-panel grain relative flex size-full flex-col text-white">
    <!-- Fondo con la foto activa desenfocada -->
    <div class="galeria-bg pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      {fotos.map((f, i) => <Image src={f.src} alt="" widths={[64]} sizes="64px" loading="lazy" class="galeria-bg-img absolute inset-0 size-full object-cover" data-bg={String(i)} />)}
      <div class="absolute inset-0 bg-[#031a1f]/80 backdrop-blur-3xl"></div>
    </div>

    <!-- Cabecera -->
    <header class="flex items-center justify-between px-4 pt-[max(1rem,env(safe-area-inset-top))] sm:px-6">
      <p class="font-mono text-xs tracking-[0.22em] text-white/60">
        <span id="galeria-idx" class="text-aqua-300">01</span>
        <span class="mx-1.5">/</span>
        <span>{pad(fotos.length)}</span>
      </p>
      <button type="button" class="galeria-ctl grid size-11 place-items-center rounded-full" aria-label={g.cerrar} data-galeria-cerrar>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </header>

    <!-- Escenario -->
    <div class="galeria-stage relative min-h-0 flex-1" data-galeria-stage>
      {
        fotos.map((f, i) => (
          <figure class="galeria-slide pointer-events-none absolute inset-0 flex items-center justify-center px-4 py-3 sm:px-20 sm:py-5" data-slide={String(i)} data-titulo={f.titulo} data-texto={f.texto}>
            <Image
              src={f.src}
              alt={f.alt}
              class="pointer-events-auto h-auto max-h-full w-auto max-w-full rounded-2xl object-contain shadow-[0_30px_80px_-20px_rgb(0_0_0/0.7)] sm:rounded-3xl"
              widths={[720, 1080, 1600]}
              sizes="(min-width: 1024px) 70vw, 100vw"
              loading="lazy"
              draggable="false"
            />
          </figure>
        ))
      }

      <button type="button" class="galeria-ctl galeria-nav absolute left-3 top-1/2 grid size-12 -translate-y-1/2 place-items-center rounded-full max-sm:hidden sm:left-5" aria-label={g.anterior} data-galeria-prev>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5" /><path d="m11 18-6-6 6-6" /></svg>
      </button>
      <button type="button" class="galeria-ctl galeria-nav absolute right-3 top-1/2 grid size-12 -translate-y-1/2 place-items-center rounded-full max-sm:hidden sm:right-5" aria-label={g.siguiente} data-galeria-next>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
      </button>
    </div>

    <!-- Pie: caption + miniaturas -->
    <footer class="px-4 pb-[max(1rem,env(safe-area-inset-bottom))] pt-2 sm:px-6">
      <div class="mx-auto flex max-w-5xl flex-col gap-4 sm:flex-row sm:items-end sm:justify-between sm:gap-8">
        <div class="galeria-cap min-w-0 sm:max-w-md" aria-live="polite">
          <h3 id="galeria-titulo" class="font-display text-xl font-medium sm:text-2xl">{fotos[0].titulo}</h3>
          <p id="galeria-texto" class="mt-1 text-sm leading-relaxed text-white/65">{fotos[0].texto}</p>
        </div>

        <div class="galeria-thumbs -mx-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:px-0" role="tablist" aria-label={g.miniaturas}>
          {
            fotos.map((f, i) => (
              <button type="button" role="tab" class="galeria-thumb relative h-14 w-11 shrink-0 overflow-hidden rounded-lg sm:h-16 sm:w-12" aria-label={f.titulo} aria-selected={i === 0 ? 'true' : 'false'} data-thumb={String(i)}>
                <Image src={f.src} alt="" widths={[96, 160]} sizes="3rem" loading="lazy" class="size-full object-cover" />
              </button>
            ))
          }
        </div>
      </div>
    </footer>
  </div>
</dialog>

<style>
  /* ── Mosaico ── */
  .tile {
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.6s var(--ease-out-expo), box-shadow 0.6s var(--ease-out-expo);
  }
  .tile:hover,
  .tile:focus-visible {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
  }
  .tile:focus-visible {
    outline: 2px solid var(--color-aqua-300);
    outline-offset: 3px;
  }
  .ver-todas {
    transition: transform 0.5s var(--ease-out-expo), box-shadow 0.5s var(--ease-out-expo), background 0.3s ease;
  }
  .ver-todas:hover {
    transform: translateY(-2px);
    background: var(--color-surface);
  }
  .ver-todas:active {
    transform: scale(0.97);
  }
  .tile-img {
    transition: transform 1.1s var(--ease-out-expo);
  }
  .tile:hover .tile-img,
  .tile:focus-visible .tile-img {
    transform: scale(1.06);
  }
  /* Velo y caption: sutiles en reposo, nítidos al pasar */
  .tile-shade {
    opacity: 0.55;
    transition: opacity 0.5s ease;
  }
  .tile-cap {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.45s ease, transform 0.6s var(--ease-out-expo);
  }
  .tile:hover .tile-shade,
  .tile:focus-visible .tile-shade {
    opacity: 1;
  }
  .tile:hover .tile-cap,
  .tile:focus-visible .tile-cap {
    opacity: 1;
    transform: translateY(0);
  }
  /* En táctil no hay hover: la foto grande muestra siempre su caption */
  @media (hover: none) {
    .tile-hero .tile-cap {
      opacity: 1;
      transform: none;
    }
    .tile-ico {
      display: none;
    }
  }

  /* ── Lightbox ── */
  .galeria {
    max-width: none;
    max-height: none;
    width: 100vw;
    height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    overflow: hidden; /* el UA pone overflow:auto en dialog:modal */
    opacity: 0;
    transition:
      opacity 0.35s ease,
      display 0.35s allow-discrete,
      overlay 0.35s allow-discrete;
  }
  .galeria[open] {
    opacity: 1;
    @starting-style {
      opacity: 0;
    }
  }
  .galeria::backdrop {
    background: rgb(3 20 24 / 0);
    transition:
      background 0.35s ease,
      display 0.35s allow-discrete,
      overlay 0.35s allow-discrete;
  }
  .galeria[open]::backdrop {
    background: rgb(3 20 24 / 0.6);
    @starting-style {
      background: rgb(3 20 24 / 0);
    }
  }
  .galeria-panel {
    transform: scale(0.985);
    transition: transform 0.6s var(--ease-out-expo);
  }
  .galeria[open] .galeria-panel {
    transform: scale(1);
    @starting-style {
      transform: scale(0.985);
    }
  }
  .galeria-panel.grain::before {
    opacity: 0.06;
    z-index: -5;
  }

  /* Fondo: solo la foto activa, desenfocada */
  .galeria-bg-img {
    opacity: 0;
    transform: scale(1.2);
    transition: opacity 0.8s ease;
  }
  .galeria-bg-img[data-active] {
    opacity: 0.9;
  }

  /* Slides: crossfade con leve deslizamiento según dirección */
  .galeria-slide {
    opacity: 0;
    transform: translateX(calc(var(--dir, 1) * 3%)) scale(0.98);
    transition: opacity 0.45s ease, transform 0.7s var(--ease-out-expo);
    visibility: hidden;
  }
  .galeria-slide[data-active] {
    opacity: 1;
    transform: none;
    visibility: visible;
  }
  .galeria-slide[data-leaving] {
    transform: translateX(calc(var(--dir, 1) * -3%)) scale(0.98);
  }

  /* Controles */
  .galeria-ctl {
    color: #fff;
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: background 0.3s ease, transform 0.45s var(--ease-out-expo), border-color 0.3s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .galeria-ctl:hover {
    background: rgb(255 255 255 / 0.16);
    border-color: rgb(255 255 255 / 0.3);
  }
  .galeria-ctl:active {
    transform: scale(0.92);
  }
  .galeria-ctl:focus-visible {
    outline: 2px solid var(--color-aqua-300);
    outline-offset: 2px;
  }
  .galeria-nav:hover {
    transform: translateY(-50%) scale(1.06);
  }
  .galeria-nav:active {
    transform: translateY(-50%) scale(0.94);
  }

  /* Caption: pequeño fade al cambiar */
  .galeria-cap {
    transition: opacity 0.25s ease, transform 0.4s var(--ease-out-expo);
  }
  .galeria-cap[data-swap] {
    opacity: 0;
    transform: translateY(6px);
  }

  /* Miniaturas */
  .galeria-thumbs {
    scrollbar-width: none;
    scroll-behavior: smooth;
  }
  .galeria-thumbs::-webkit-scrollbar {
    display: none;
  }
  .galeria-thumb {
    opacity: 0.45;
    outline: 2px solid transparent;
    outline-offset: 2px;
    transition: opacity 0.3s ease, outline-color 0.3s ease, transform 0.45s var(--ease-out-expo);
    -webkit-tap-highlight-color: transparent;
  }
  .galeria-thumb:hover {
    opacity: 0.8;
  }
  .galeria-thumb[aria-selected='true'] {
    opacity: 1;
    outline-color: var(--color-aqua-300);
    transform: translateY(-2px);
  }
  .galeria-thumb:focus-visible {
    opacity: 1;
    outline-color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .tile,
    .tile-img,
    .tile-cap,
    .ver-todas,
    .galeria,
    .galeria::backdrop,
    .galeria-panel,
    .galeria-slide,
    .galeria-bg-img,
    .galeria-cap,
    .galeria-thumb {
      transition-duration: 0.01ms !important;
      animation: none !important;
    }
    .galeria-slide,
    .galeria-panel {
      transform: none !important;
    }
  }
</style>

<script>
  const dlg = document.getElementById('galeria') as HTMLDialogElement | null;

  if (dlg && typeof dlg.showModal === 'function') {
    const root = document.documentElement;
    const slides = [...dlg.querySelectorAll<HTMLElement>('[data-slide]')];
    const bgs = [...dlg.querySelectorAll<HTMLElement>('[data-bg]')];
    const thumbs = [...dlg.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    const strip = dlg.querySelector<HTMLElement>('.galeria-thumbs');
    const stage = dlg.querySelector<HTMLElement>('[data-galeria-stage]');
    const cap = dlg.querySelector<HTMLElement>('.galeria-cap');
    const idxEl = document.getElementById('galeria-idx');
    const tituloEl = document.getElementById('galeria-titulo');
    const textoEl = document.getElementById('galeria-texto');
    const n = slides.length;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let actual = 0;
    let abierta = false;
    let abridor: HTMLElement | null = null;

    const pad = (k: number) => String(k + 1).padStart(2, '0');

    const mostrar = (k: number, dir = 1) => {
      const prev = actual;
      actual = ((k % n) + n) % n;
      stage?.style.setProperty('--dir', String(dir));

      slides.forEach((s, j) => {
        s.toggleAttribute('data-active', j === actual);
        s.toggleAttribute('data-leaving', j === prev && prev !== actual);
      });
      bgs.forEach((b, j) => b.toggleAttribute('data-active', j === actual));
      thumbs.forEach((b, j) => b.setAttribute('aria-selected', String(j === actual)));

      if (idxEl) idxEl.textContent = pad(actual);

      const s = slides[actual];
      const swap = () => {
        if (tituloEl) tituloEl.textContent = s.dataset.titulo || '';
        if (textoEl) textoEl.textContent = s.dataset.texto || '';
        cap?.removeAttribute('data-swap');
      };
      if (reduce || prev === actual) swap();
      else {
        cap?.setAttribute('data-swap', '');
        setTimeout(swap, 220);
      }

      // Centrar la miniatura activa sin mover la página
      const th = thumbs[actual];
      if (strip && th) {
        strip.scrollTo({ left: th.offsetLeft - strip.clientWidth / 2 + th.clientWidth / 2, behavior: reduce ? 'auto' : 'smooth' });
      }
    };

    const abrir = (k: number, origen: HTMLElement | null) => {
      abridor = origen;
      mostrar(k, 1);
      // Sin animación de "leaving" en la primera apertura
      slides.forEach((s) => s.removeAttribute('data-leaving'));
      dlg.showModal();
      abierta = true;
      root.classList.add('galeria-open');
      dlg.querySelector<HTMLElement>('[data-galeria-cerrar]')?.focus({ preventScroll: true });
    };

    const cerrar = () => dlg.close();

    document.querySelectorAll<HTMLElement>('[data-galeria-abrir]').forEach((b) => {
      b.addEventListener('click', () => abrir(Number(b.dataset.galeriaAbrir || 0), b));
    });
    dlg.querySelector('[data-galeria-cerrar]')?.addEventListener('click', cerrar);
    dlg.querySelector('[data-galeria-prev]')?.addEventListener('click', () => mostrar(actual - 1, -1));
    dlg.querySelector('[data-galeria-next]')?.addEventListener('click', () => mostrar(actual + 1, 1));
    thumbs.forEach((b, j) => b.addEventListener('click', () => mostrar(j, j > actual ? 1 : -1)));

    // Limpieza al cerrar (botón, Esc, light-dismiss). Se escucha `close` y
    // también `toggle`: algunas versiones de Chrome no emiten `close` en
    // diálogos con transición `display/overlay allow-discrete`.
    const onCerrado = () => {
      if (!abierta) return;
      abierta = false;
      root.classList.remove('galeria-open');
      abridor?.focus({ preventScroll: true });
    };
    dlg.addEventListener('close', onCerrado);
    dlg.addEventListener('toggle', (e) => {
      if ((e as ToggleEvent).newState === 'closed') onCerrado();
    });

    // Light-dismiss: el panel cubre todo el viewport, así que el clic "fuera"
    // es cualquier punto del escenario que no sea la foto ni un control.
    stage?.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('img, button')) cerrar();
    });

    // Teclado
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') mostrar(actual + 1, 1);
      else if (e.key === 'ArrowLeft') mostrar(actual - 1, -1);
    });

    // Swipe horizontal en táctil
    let x0 = 0;
    let y0 = 0;
    stage?.addEventListener('pointerdown', (e) => {
      x0 = e.clientX;
      y0 = e.clientY;
    });
    stage?.addEventListener('pointerup', (e) => {
      const dx = e.clientX - x0;
      const dy = e.clientY - y0;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) mostrar(actual + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
    });
  }
</script>
