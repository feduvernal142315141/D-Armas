---
import tooth from '../assets/brand/tooth.svg?raw';
import { useT, asLocale } from '../i18n';

const t = useT(asLocale(Astro.currentLocale));

// Iconos de trazo (se "dibujan" al entrar en pantalla con DrawSVG)
const pilares = [
  {
    ...t.nosotros.mision,
    icono: [
      'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z',
      'M12 16.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Z',
      'M12 12h.01',
    ],
  },
  {
    ...t.nosotros.vision,
    icono: ['M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z', 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z', 'M12 2.5v1.5M12 20v1.5'],
  },
];

const iconosValores = [
  // Corazón
  ['M12 20.5s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.9c0 5.4-7.5 10-7.5 10Z'],
  // Medalla
  ['M12 15a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z', 'M8.5 14 7 21l5-2.5L17 21l-1.5-7'],
  // Escudo con check
  ['M12 3 4.5 6v5.5c0 4.4 3.2 8 7.5 9.5 4.3-1.5 7.5-5.1 7.5-9.5V6L12 3Z', 'm9 12 2 2 4-4.5'],
  // Destellos
  ['M12 4l1.6 4.4L18 10l-4.4 1.6L12 16l-1.6-4.4L6 10l4.4-1.6L12 4Z', 'M5 17.5l.7 1.8 1.8.7-1.8.7L5 22.5l-.7-1.8-1.8-.7 1.8-.7.7-1.8Z'],
];
---

<section id="nosotros" class="nosotros relative scroll-mt-24 overflow-hidden bg-ice">
  <!-- Luces de escenario: foco superior + auroras que derivan -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[28rem] bg-[radial-gradient(60rem_26rem_at_50%_-8rem,rgb(91_216_224/0.32),transparent_70%)] dark:bg-[radial-gradient(60rem_26rem_at_50%_-8rem,rgb(91_216_224/0.14),transparent_70%)]"></div>
  <div class="nos-aurora nos-aurora-a pointer-events-none absolute -left-32 top-1/3 size-[40rem] rounded-full bg-radial-[closest-side] from-teal-500/20 to-transparent dark:from-teal-500/25"></div>
  <div class="nos-aurora nos-aurora-b pointer-events-none absolute -right-28 bottom-0 size-[34rem] rounded-full bg-radial-[closest-side] from-aqua-300/30 to-transparent dark:from-aqua-300/15"></div>
  <!-- Marca de agua: el diente del logo -->
  <div class="tooth-mark -right-10 top-10" set:html={tooth} data-parallax-slow />

  <div class="relative mx-auto max-w-6xl px-5 py-16 sm:py-24 lg:px-8 lg:py-32">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow justify-center after:h-[1.5px] after:w-8 after:bg-aqua-300 after:content-['']" data-reveal>
        {t.nosotros.eyebrow}
      </p>
      <h2 class="display mt-5 text-[clamp(1.9rem,4.5vw,3rem)]" data-split set:html={t.nosotros.statement} />
      <p class="mt-6 leading-relaxed text-ink-soft lg:text-lg" data-reveal>{t.nosotros.texto}</p>
    </div>

    <!-- ── Misión / Visión: tarjetas "spotlight" ──
         El borde y un halo interior siguen el puntero (también desde tarjetas vecinas),
         un arco de luz recorre el borde lentamente y en escritorio la tarjeta se inclina en 3D. -->
    <div class="spot-grid mx-auto mt-12 grid max-w-4xl gap-5 sm:grid-cols-2 lg:mt-16 lg:gap-6">
      {
        pilares.map((c, i) => (
          <article class="spot group rounded-3xl" data-reveal data-delay={String(i * 0.12)} data-spot>
            <div class="spot-inner flex h-full flex-col rounded-[calc(1.5rem-1.5px)] p-8 lg:p-9">
              <span class="spot-icon relative inline-grid size-14 place-items-center self-start rounded-2xl bg-ice text-teal-500 dark:text-aqua-300">
                <span class="spot-ring" />
                <span class="spot-ring" style="animation-delay: 1.2s" />
                <svg class="relative size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-draw>
                  {c.icono.map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              </span>
              <h3 class="font-display mt-6 text-[1.65rem] font-medium leading-tight">{c.titulo}</h3>
              <p class="mt-3 leading-relaxed text-ink-soft">{c.texto}</p>
              <ul class="mt-auto flex flex-wrap gap-2 pt-6">
                {c.claves.map((k) => (
                  <li class="spot-chip whitespace-nowrap rounded-full px-3 py-1 text-xs font-semibold">{k}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <!-- ── Valores ── -->
    <p class="eyebrow mt-14 justify-center after:h-[1.5px] after:w-8 after:bg-aqua-300 after:content-[''] lg:mt-20" data-reveal>{t.nosotros.valoresEyebrow}</p>
    <ul class="spot-grid mx-auto mt-6 grid max-w-5xl grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-4">
      {
        t.nosotros.valores.map((v, i) => (
          <li class="spot spot-sm rounded-2xl" data-reveal data-delay={String(0.1 + i * 0.08)} data-spot>
            <div class="spot-inner h-full rounded-[calc(1rem-1.5px)] p-5">
              <span class="spot-icon inline-grid size-10 place-items-center rounded-xl bg-ice text-teal-500 dark:text-aqua-300">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-draw>
                  {iconosValores[i].map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              </span>
              <h3 class="font-display mt-4 text-lg font-medium leading-tight">{v.nombre}</h3>
              <p class="mt-1 text-sm leading-relaxed text-ink-soft">{v.texto}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .nos-aurora-a { animation: nos-drift-a 16s ease-in-out infinite alternate; }
  .nos-aurora-b { animation: nos-drift-b 20s ease-in-out infinite alternate; }
  @keyframes nos-drift-a { to { transform: translate(6rem, -4rem) scale(1.12); } }
  @keyframes nos-drift-b { to { transform: translate(-5rem, -6rem) scale(1.08); } }
  @media (prefers-reduced-motion: reduce) {
    .nos-aurora { animation: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';
  import { initSpotlight } from '../scripts/spotlight';

  gsap.registerPlugin(ScrollTrigger, DrawSVGPlugin);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const seccion = document.getElementById('nosotros');

  if (seccion) {
    initSpotlight(seccion);

    // ── Los iconos se dibujan al entrar en pantalla ──
    if (!reduce) {
      seccion.querySelectorAll<SVGElement>('[data-draw]').forEach((svg) => {
        gsap.from(svg.querySelectorAll('path'), {
          drawSVG: '0%',
          duration: 1.3,
          ease: 'power2.inOut',
          stagger: 0.12,
          scrollTrigger: { trigger: svg, start: 'top 88%' },
        });
      });
    }
  }
</script>
