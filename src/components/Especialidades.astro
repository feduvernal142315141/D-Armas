---
import { waLink } from '../data/clinica';
import { useT, asLocale } from '../i18n';

const t = useT(asLocale(Astro.currentLocale));

const iconos: Record<string, string> = {
  ortodoncia:
    'M4 12c0-4 3-7 8-7s8 3 8 7M4 12c0 4 3 7 8 7s8-3 8-7M4 12h16M8 9.5v5M12 9.5v5M16 9.5v5',
  endodoncia: 'M12 3c-3 0-5 2-5 5 0 4 2 5 2 9l1.5 4 1-6h1l1 6L15 17c0-4 2-5 2-9 0-3-2-5-5-5Z',
  rehabilitacion: 'M5 8l3 3 4-5 4 5 3-3v8a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3V8Z',
  maxilofacial:
    'M8 4c-2.2 0-4 1.8-4 4 0 3 1.5 4 1.5 7L7 19l1-4.5h1L10 19l1.5-4c0-3 1.5-4 1.5-7 0-2.2-1.8-4-4-4ZM15 6h6M18 3v6',
  general: 'M12 21a9 9 0 1 0-9-9c0 5 4 9 9 9Zm-4-9 3 3 5-6',
};
---

<section id="especialidades" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-16 sm:py-24 lg:px-8 lg:py-32">
  <div class="max-w-2xl">
    <p class="eyebrow" data-reveal>{t.especialidades.eyebrow}</p>
    <h2 class="display mt-4 text-[clamp(2rem,4.5vw,3.2rem)]" data-reveal set:html={t.especialidades.titulo} />
    <p class="mt-5 text-lg text-ink-soft" data-reveal>{t.especialidades.sub}</p>
  </div>

  <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      t.especialidades.items.map((e, i) => (
        <article
          class:list={[
            'group relative flex flex-col justify-between overflow-hidden rounded-3xl p-7 transition-all duration-500 hover:-translate-y-1.5',
            e.destacado
              ? 'bg-teal-900 text-white shadow-lift'
              : 'border border-teal-900/10 bg-surface text-ink shadow-card hover:shadow-lift dark:border-white/10',
            e.id === 'general' && 'sm:col-span-2 lg:flex-row lg:items-center lg:gap-12',
          ]}
          data-reveal
          data-delay={String((i % 3) * 0.08)}
        >
          {e.destacado && (
            <div class="pointer-events-none absolute -right-16 -top-16 size-56 rounded-full bg-aqua-300/15 blur-3xl transition-transform duration-700 group-hover:scale-150" />
          )}
          {e.id === 'general' && (
            <div class="pointer-events-none absolute -bottom-20 -left-16 size-56 rounded-full bg-aqua-300/10 blur-3xl transition-transform duration-700 group-hover:scale-150" />
          )}
          <div class:list={[e.id === 'general' && 'lg:flex lg:flex-1 lg:items-center lg:gap-8']}>
            <span
              class:list={[
                'inline-flex size-12 shrink-0 items-center justify-center rounded-2xl',
                e.destacado ? 'bg-white/10 text-aqua-300' : 'bg-ice text-teal-500 dark:text-aqua-300',
                e.id === 'general' && 'lg:size-16 lg:rounded-3xl',
              ]}
            >
              <svg class:list={['size-6', e.id === 'general' && 'lg:size-8']} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={iconos[e.id]} />
              </svg>
            </span>
            {e.destacado && (
              <span class="ml-3 rounded-full bg-aqua-300/15 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-aqua-300">
                {t.especialidades.foco}
              </span>
            )}
            <div>
              <h3 class:list={['font-display mt-5 text-2xl font-medium', e.id === 'general' && 'lg:mt-0']}>{e.nombre}</h3>
              <p class:list={['mt-3 leading-relaxed max-sm:line-clamp-3 max-sm:text-sm', e.destacado ? 'text-white/70' : 'text-ink-soft', e.id === 'general' && 'lg:mt-2 lg:max-w-xl']}>
                {e.descripcion}
              </p>
            </div>
          </div>

          <div class:list={['mt-6', e.id === 'general' && 'lg:mt-0 lg:shrink-0 lg:border-l lg:border-teal-900/10 lg:pl-10 dark:lg:border-white/10']}>
            <div class:list={['flex flex-wrap gap-2', e.id === 'general' && 'lg:max-w-[16rem]']}>
              {e.tags.map((tag) => (
                <span
                  class:list={[
                    'rounded-full px-3 py-1 text-xs font-medium',
                    e.destacado ? 'bg-white/10 text-white/85' : 'bg-ice text-teal-700 dark:text-aqua-300',
                  ]}
                >
                  {tag}
                </span>
              ))}
            </div>
            <a
              href={waLink(t.whatsapp.tratamiento(e.nombre))}
              target="_blank"
              rel="noopener"
              class:list={[
                'link-under mt-5 inline-flex items-center gap-2 text-sm font-semibold',
                e.destacado ? 'text-aqua-300' : 'text-teal-500',
              ]}
            >
              {t.especialidades.consultar}
              <svg class="size-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
