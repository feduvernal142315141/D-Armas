---
import { clinica, waLink, mapLinks } from '../data/clinica';
import { useT, asLocale } from '../i18n';

const t = useT(asLocale(Astro.currentLocale));
const wa = waLink(t.whatsapp.cita);
const m = t.contacto.mapa;
const direccionCompleta = `${t.contacto.direccion}, ${t.contacto.ciudadPais}`;
---

<section id="contacto" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-16 sm:py-24 lg:px-8 lg:py-32">
  <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
    <div>
      <p class="eyebrow" data-reveal>{t.contacto.eyebrow}</p>
      <h2 class="display mt-4 text-[clamp(2rem,4.5vw,3.2rem)]" data-reveal set:html={t.contacto.titulo} />

      <dl class="mt-10 space-y-6">
        <div class="flex gap-4" data-reveal>
          <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-2xl bg-ice text-teal-500 dark:text-aqua-300">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.1-7-11a7 7 0 0 1 14 0c0 5.9-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
          </span>
          <div>
            <dt class="font-semibold">{t.contacto.direccionLabel}</dt>
            <dd class="mt-1 text-ink-soft">
              {t.contacto.direccion}, {t.contacto.ciudadPais}.
              <a href={clinica.mapsUrl} target="_blank" rel="noopener" class="link-under ml-2 font-semibold text-teal-500">{t.contacto.verMaps}</a>
            </dd>
          </div>
        </div>

        <div class="flex gap-4" data-reveal data-delay="0.08">
          <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-2xl bg-ice text-teal-500 dark:text-aqua-300">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          </span>
          <div>
            <dt class="font-semibold">{t.contacto.horariosLabel}</dt>
            <dd class="mt-1 space-y-0.5 text-ink-soft">
              {t.contacto.horarios.map((h) => (
                <p>
                  <span class="font-medium text-ink">{h.dias}:</span> {h.horas}
                </p>
              ))}
            </dd>
          </div>
        </div>

        <div class="flex gap-4" data-reveal data-delay="0.16">
          <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-2xl bg-ice text-teal-500 dark:text-aqua-300">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.5v3a2 2 0 0 1-2.2 2A19.5 19.5 0 0 1 2.5 4.2 2 2 0 0 1 4.5 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.68 2.8a2 2 0 0 1-.45 2.1L8.6 9.7a16 16 0 0 0 5.7 5.7l1.1-1.13a2 2 0 0 1 2.1-.45c.9.32 1.84.55 2.8.68a2 2 0 0 1 1.7 2Z"/></svg>
          </span>
          <div>
            <dt class="font-semibold">{t.contacto.telefonoLabel}</dt>
            <dd class="mt-1 text-ink-soft">
              <a href={`tel:${clinica.telefono}`} class="link-under font-semibold text-teal-500">{clinica.telefonoDisplay}</a>
              · {t.contacto.tambien} <a href={wa} target="_blank" rel="noopener" class="link-under font-semibold text-teal-500">WhatsApp</a>
            </dd>
          </div>
        </div>
      </dl>
    </div>

    <!-- ── Mapa: fachada interactiva ──
         El iframe carga perezoso y queda inerte (sin secuestrar el scroll) hasta que el
         usuario lo activa. La tarjeta ofrece las acciones reales: cómo llegar (Google /
         Waze / Apple Maps), copiar dirección y estado de apertura en vivo. -->
    <div class="mapa relative overflow-hidden rounded-3xl bg-ice shadow-lift" data-mapa data-reveal data-delay="0.1">
      <iframe
        title={t.contacto.mapaTitle}
        src={clinica.mapsEmbed}
        class="mapa-frame aspect-[4/3] w-full border-0 sm:aspect-[5/4] lg:aspect-[4/3.6]"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        tabindex="-1"
        allowfullscreen
      ></iframe>

      <!-- Velo de marca + pin con pulso sobre la ubicación (centro del embed) -->
      <div class="mapa-velo pointer-events-none absolute inset-0">
        <div class="mapa-pin absolute left-1/2 top-1/2">
          <span class="mapa-pulso"></span>
          <span class="mapa-pulso" style="animation-delay: 0.9s"></span>
          <span class="mapa-pin-core grid size-10 -translate-x-1/2 -translate-y-[88%] place-items-center rounded-full bg-teal-900 text-aqua-300 shadow-lift ring-4 ring-white/80 dark:bg-aqua-300 dark:text-teal-900 dark:ring-teal-900/60">
            <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5c-3.6 0-6.5 2.4-6.5 6 0 1.2.3 2.4.9 3.5 1.1 2 1.4 4.6 1.9 6.8.3 1.3.8 2.7 2 2.7 1 0 1.2-1.4 1.7-2.4.5 1 .7 2.4 1.7 2.4 1.2 0 1.7-1.4 2-2.7.5-2.2.8-4.8 1.9-6.8.6-1.1.9-2.3.9-3.5 0-3.6-2.9-6-6.5-6Z"/></svg>
          </span>
        </div>
      </div>

      <!-- Activar interacción -->
      <button
        type="button"
        class="mapa-activar absolute left-1/2 top-[30%] inline-flex -translate-x-1/2 items-center gap-2 rounded-full bg-surface/85 py-2.5 pl-3.5 pr-5 text-sm font-semibold text-ink shadow-lift ring-1 ring-teal-900/10 backdrop-blur-xl dark:ring-white/10"
        data-mapa-activar
      >
        <svg class="size-4 text-teal-500 dark:text-aqua-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 9l4-2 6 2 4-2v10l-4 2-6-2-4 2Z"/><path d="M9 7v10M15 9v10"/></svg>
        {m.explorar}
      </button>

      <!-- Bloquear de nuevo (visible solo con el mapa activo) -->
      <button
        type="button"
        class="mapa-bloquear absolute right-3 top-3 grid size-10 place-items-center rounded-full bg-surface/85 text-ink shadow-card ring-1 ring-teal-900/10 backdrop-blur-xl dark:ring-white/10"
        aria-label={m.bloquear}
        data-mapa-bloquear
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
      </button>

      <!-- Tarjeta de acciones -->
      <div class="mapa-card absolute inset-x-3 bottom-3 rounded-2xl bg-surface/90 p-4 shadow-lift ring-1 ring-teal-900/10 backdrop-blur-xl sm:bottom-4 sm:left-4 sm:right-auto sm:w-[21rem] dark:ring-white/10">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="font-display text-lg font-medium leading-tight">{clinica.nombre}</p>
            <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-ink-soft">{direccionCompleta}</p>
          </div>
          <a href={clinica.mapsUrl} target="_blank" rel="noopener" class="shrink-0 rounded-full bg-ice p-2 text-teal-500 transition-colors hover:text-teal-900 dark:text-aqua-300 dark:hover:text-white" aria-label={t.contacto.verMaps}>
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4 10 14"/><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></svg>
          </a>
        </div>

        <p
          class="mapa-estado mt-2.5 flex items-center gap-1.5 text-xs font-medium text-ink-soft"
          data-mapa-estado
          data-abierto={m.abierto}
          data-cerrado={m.cerrado}
          data-cierra={m.cierra}
          data-abre={m.abre}
          data-hoy={m.hoy}
          data-manana={m.manana}
          hidden
        >
          <span class="mapa-dot size-2 rounded-full bg-ink-soft/50"></span>
          <span data-mapa-estado-texto></span>
        </p>

        <div class="mt-3.5 flex flex-wrap gap-2" role="group" aria-label={m.ariaAcciones}>
          <a href={mapLinks.google} target="_blank" rel="noopener" class="btn btn-dark !gap-2 !px-4 !py-2.5 !text-sm">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l18-8-8 18-2-8Z"/></svg>
            {m.comoLlegar}
          </a>
          <a href={mapLinks.waze} target="_blank" rel="noopener" class="mapa-chip" aria-label="Waze">
            <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.3 2C8.6 2 5 5.5 5 10.2v1.3c0 1.6-.9 3-2.3 3.3-.5.1-.7.7-.4 1.1 1 1.4 2.6 2.4 4.3 2.8a2.8 2.8 0 0 0 5.4.3h2.2a2.8 2.8 0 0 0 5.4-.4c2.3-1 3.9-3.4 3.9-6.1C23.5 6.5 18.9 2 13.3 2Zm-2.6 7a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2Zm5.6 0a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2Zm-6 4.3h6.3c.4 0 .6.4.4.7a3.9 3.9 0 0 1-7.1 0c-.2-.3 0-.7.4-.7Z"/></svg>
            Waze
          </a>
          <a href={mapLinks.apple} target="_blank" rel="noopener" class="mapa-chip" data-mapa-apple hidden>
            <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7a4.5 4.5 0 0 0-3.5-1.9c-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8a4.7 4.7 0 0 0-4 2.4c-1.7 2.9-.4 7.3 1.2 9.7.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.3 1.3-2.6 1.3-2.7 0 0-2.6-1-2.6-3.9ZM14 5.4c.7-.8 1.1-1.9 1-3-1 0-2.1.6-2.8 1.4-.6.7-1.2 1.8-1 2.9 1.1.1 2.2-.5 2.8-1.3Z"/></svg>
            Apple Maps
          </a>
          <button type="button" class="mapa-chip" data-mapa-copiar data-label={m.copiar} data-label-ok={m.copiado} data-direccion={direccionCompleta}>
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a1 1 0 0 1 1-1h10"/></svg>
            <span>{m.copiar}</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Estado inerte: el mapa se ve (atenuado y entonado a la marca) pero no captura
        el scroll ni el puntero hasta activarlo. ── */
  .mapa-frame {
    display: block;
    pointer-events: none;
    filter: saturate(0.7) contrast(1.04);
    transition: filter 0.6s ease, transform 1.2s var(--ease-out-expo);
    transform: scale(1.02);
  }
  :global([data-theme='dark']) .mapa-frame {
    filter: invert(0.88) hue-rotate(180deg) saturate(0.6);
  }
  .mapa-velo {
    background:
      radial-gradient(60% 55% at 50% 50%, transparent 0%, rgb(6 86 99 / 0.1) 100%),
      linear-gradient(180deg, rgb(6 86 99 / 0.05), rgb(6 86 99 / 0.18));
    transition: opacity 0.6s ease;
  }
  :global([data-theme='dark']) .mapa-velo {
    background:
      radial-gradient(60% 55% at 50% 50%, transparent 0%, rgb(3 26 31 / 0.35) 100%),
      linear-gradient(180deg, rgb(3 26 31 / 0.1), rgb(3 26 31 / 0.45));
  }

  /* Pin con pulso sobre la ubicación */
  .mapa-pin-core {
    animation: pin-drop 0.9s var(--ease-out-expo) both;
  }
  .mapa-pulso {
    position: absolute;
    left: 0;
    top: 0;
    width: 14px;
    height: 14px;
    translate: -50% -50%;
    border-radius: 999px;
    background: rgb(27 152 166 / 0.35);
    animation: pin-pulse 1.8s ease-out infinite;
  }
  @keyframes pin-pulse {
    from { scale: 1; opacity: 0.8; }
    to { scale: 5; opacity: 0; }
  }
  @keyframes pin-drop {
    from { transform: translate(-50%, -200%); opacity: 0; }
    to { transform: translate(-50%, -88%); opacity: 1; }
  }

  /* Controles */
  .mapa-activar,
  .mapa-bloquear,
  .mapa-card {
    transition: opacity 0.45s ease, transform 0.6s var(--ease-out-expo), visibility 0s linear 0s;
  }
  .mapa-activar:hover {
    transform: translate(-50%, -2px);
  }
  .mapa-bloquear {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition-delay: 0s, 0s, 0.45s;
  }

  /* ── Estado activo ── */
  .mapa.is-active .mapa-frame {
    pointer-events: auto;
    filter: none;
    transform: none;
  }
  :global([data-theme='dark']) .mapa.is-active .mapa-frame {
    filter: invert(0.88) hue-rotate(180deg) saturate(0.7);
  }
  .mapa.is-active .mapa-velo {
    opacity: 0;
  }
  .mapa.is-active .mapa-activar {
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -10px);
    transition-delay: 0s, 0s, 0.45s;
  }
  .mapa.is-active .mapa-bloquear {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0.15s, 0.15s, 0s;
  }
  /* Con el mapa activo la tarjeta se aparta para dejar ver más mapa */
  .mapa.is-active .mapa-card {
    transform: translateY(calc(100% - 3.9rem));
  }
  .mapa.is-active .mapa-card:hover,
  .mapa.is-active .mapa-card:focus-within {
    transform: none;
  }
  @media (max-width: 639px) {
    .mapa.is-active .mapa-card {
      transform: translateY(calc(100% + 1rem));
    }
    .mapa.is-active .mapa-card:focus-within {
      transform: none;
    }
  }

  /* Chips secundarios */
  .mapa-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-ink);
    background: color-mix(in oklab, var(--color-ink) 7%, transparent);
    transition: background 0.3s ease, transform 0.45s var(--ease-out-expo), color 0.3s ease;
  }
  .mapa-chip:hover {
    background: color-mix(in oklab, var(--color-ink) 12%, transparent);
    transform: translateY(-1px);
  }
  .mapa-chip:active {
    transform: scale(0.97);
  }
  .mapa-chip.is-ok {
    color: var(--color-teal-900);
    background: color-mix(in oklab, var(--color-aqua-300) 45%, transparent);
  }
  :global([data-theme='dark']) .mapa-chip.is-ok {
    color: var(--color-aqua-300);
    background: color-mix(in oklab, var(--color-aqua-300) 18%, transparent);
  }

  /* Estado de apertura */
  .mapa-estado.is-open .mapa-dot {
    background: #22c55e;
    box-shadow: 0 0 0 3px rgb(34 197 94 / 0.2);
  }
  .mapa-estado.is-closed .mapa-dot {
    background: #f59e0b;
    box-shadow: 0 0 0 3px rgb(245 158 11 / 0.2);
  }

  @media (prefers-reduced-motion: reduce) {
    .mapa-pulso,
    .mapa-pin-core {
      animation: none;
    }
    .mapa-pin-core {
      transform: translate(-50%, -88%);
    }
    .mapa-frame,
    .mapa-activar,
    .mapa-bloquear,
    .mapa-card,
    .mapa-chip {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  import { estadoApertura, textosDesde } from '../scripts/horario';

  const mapa = document.querySelector<HTMLElement>('[data-mapa]');

  if (mapa) {
    const activar = mapa.querySelector<HTMLButtonElement>('[data-mapa-activar]');
    const bloquear = mapa.querySelector<HTMLButtonElement>('[data-mapa-bloquear]');
    const velo = mapa.querySelector<HTMLElement>('.mapa-velo');
    const frame = mapa.querySelector<HTMLIFrameElement>('iframe');
    const soloHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    const setActivo = (on: boolean) => {
      mapa.classList.toggle('is-active', on);
      frame?.setAttribute('tabindex', on ? '0' : '-1');
    };

    activar?.addEventListener('click', () => setActivo(true));
    bloquear?.addEventListener('click', () => setActivo(false));
    // Un clic en cualquier zona libre del mapa también lo activa
    velo?.addEventListener('click', () => setActivo(true));
    mapa.addEventListener('click', (e) => {
      if (mapa.classList.contains('is-active')) return;
      const el = e.target as HTMLElement;
      if (!el.closest('.mapa-card, [data-mapa-bloquear]')) setActivo(true);
    });
    // En escritorio, al salir con el puntero vuelve a quedar inerte para no
    // interrumpir el scroll de la página al volver a pasar por encima
    if (soloHover) mapa.addEventListener('mouseleave', () => setActivo(false));
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setActivo(false);
    });

    // Apple Maps solo en plataformas Apple (ahí es la app nativa)
    const esApple = /iPhone|iPad|iPod|Macintosh/.test(navigator.userAgent);
    if (esApple) mapa.querySelector('[data-mapa-apple]')?.removeAttribute('hidden');

    // Copiar dirección
    const copiar = mapa.querySelector<HTMLButtonElement>('[data-mapa-copiar]');
    copiar?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copiar.dataset.direccion || '');
        const label = copiar.querySelector('span');
        if (label) label.textContent = copiar.dataset.labelOk || '';
        copiar.classList.add('is-ok');
        setTimeout(() => {
          if (label) label.textContent = copiar.dataset.label || '';
          copiar.classList.remove('is-ok');
        }, 1800);
      } catch {
        /* sin permiso de portapapeles: el texto sigue visible en la tarjeta */
      }
    });

    // ── Estado "Abierto ahora" en la zona horaria de la clínica ──
    const estado = mapa.querySelector<HTMLElement>('[data-mapa-estado]');
    const estadoTexto = mapa.querySelector<HTMLElement>('[data-mapa-estado-texto]');
    if (estado && estadoTexto) {
      const { abierto, texto } = estadoApertura(document.documentElement.lang || 'es', textosDesde(estado));
      estadoTexto.textContent = texto;
      estado.classList.add(abierto ? 'is-open' : 'is-closed');
      estado.hidden = false;
    }
  }
</script>
