---
import { Image } from 'astro:assets';
import draPatricia from '../assets/photos/dra-patricia.jpg';
import { clinica, waLink } from '../data/clinica';
import { useT, asLocale } from '../i18n';

const t = useT(asLocale(Astro.currentLocale));
const wa = waLink(t.whatsapp.cita);
---

<section id="inicio" class="grain relative isolate overflow-hidden text-ink dark:text-white">
  <!-- Fondo adaptativo: luminoso en claro, gradiente profundo en oscuro -->
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(90rem_60rem_at_80%_-20%,#c9e9ec_0%,#e6f3f4_38%,#f6fafa_75%)] dark:hidden"></div>
  <div class="absolute inset-0 -z-10 hidden bg-[radial-gradient(90rem_60rem_at_80%_-20%,#0b7482_0%,#065663_38%,#043a42_72%,#032a30_100%)] dark:block"></div>
  <div class="pointer-events-none absolute -left-40 top-1/3 -z-10 size-[34rem] rounded-full bg-teal-500/15 blur-[120px] dark:bg-teal-500/25"></div>
  <div class="pointer-events-none absolute -right-24 -top-24 -z-10 size-[28rem] rounded-full bg-aqua-300/25 blur-[100px] dark:bg-aqua-300/15"></div>

  <div class="mx-auto grid max-w-6xl gap-10 px-5 pb-16 pt-28 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-10 lg:px-8 lg:pb-32 lg:pt-44">
    <div>
      <p class="hero-seq eyebrow dark:!text-aqua-300" data-hero-fade>
        <span class="sm:hidden">{t.hero.eyebrowCorto}</span>
        <span class="max-sm:hidden">{t.hero.eyebrowLargo}</span>
      </p>

      <h1 class="hero-seq display mt-5 text-[clamp(2.4rem,11vw,4.6rem)] lg:mt-6" data-hero-title set:html={t.hero.titulo} />

      <p class="hero-seq mt-5 max-w-xl leading-relaxed text-ink-soft lg:mt-6 lg:text-lg dark:text-white/75" data-hero-fade>
        <span class="sm:hidden">{t.hero.subCorto}</span>
        <span class="max-sm:hidden">{t.hero.subLargo}</span>
      </p>

      <div class="hero-seq mt-8 flex flex-wrap items-center gap-4 lg:mt-9" data-hero-fade>
        <a href={wa} target="_blank" rel="noopener" class="btn btn-primary max-sm:w-full">
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.4 14.1c-.2.7-1.3 1.3-1.9 1.4-.5.1-1.1.1-1.8-.1a16 16 0 0 1-1.6-.6c-2.8-1.2-4.7-4.1-4.8-4.3-.1-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.2-.3.5-.4.7-.4h.5c.2 0 .4 0 .6.4l.9 2.2c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.1.3.7 1.2 1.6 1.9 1.1 1 2 1.3 2.3 1.4.3.1.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l2 .9c.3.2.5.3.6.4 0 .2 0 .7-.2 1.1Z"/></svg>
          {t.hero.ctaWhatsapp}
        </a>
        <a href={`tel:${clinica.telefono}`} class="btn btn-outline max-sm:hidden">{t.hero.ctaLlamar}</a>
      </div>
    </div>

    <!-- Tarjeta de la doctora con chips glass -->
    <div class="relative mx-auto w-full max-w-sm lg:max-w-none">
      <div class="hero-seq relative overflow-hidden rounded-[2rem] shadow-lift" data-hero-card>
        <div class="overflow-hidden">
          <Image
            src={draPatricia}
            alt={t.hero.fotoAlt}
            class="aspect-[4/5] w-full object-cover object-top max-sm:aspect-[3/4] lg:scale-[1.12]"
            widths={[420, 640, 900]}
            sizes="(min-width: 1024px) 26rem, 90vw"
            loading="eager"
            fetchpriority="high"
            data-parallax
          />
        </div>
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-deep/85 to-transparent p-5 pt-14 text-white">
          <p class="font-display text-xl font-medium">{t.hero.draNombre}</p>
          <p class="text-sm text-aqua-300">{t.hero.draCargo}</p>
        </div>
      </div>

      <div class="hero-chip hero-seq absolute -left-6 top-8 rounded-2xl px-4 py-3 shadow-card max-lg:hidden" data-hero-chip>
        <p class="text-2xl font-semibold text-teal-500 dark:text-aqua-300">{t.hero.chipValor}</p>
        <p class="text-xs text-ink-soft dark:text-white/80">{t.hero.chipLabel}</p>
      </div>
      <div class="hero-chip hero-seq absolute -right-4 bottom-24 rounded-2xl px-4 py-3 shadow-card max-lg:hidden" data-hero-chip>
        <p class="flex items-center gap-1 text-sm font-semibold">
          <svg class="size-4 text-teal-500 dark:text-aqua-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5 12.6 7l6 .6-4.5 4 1.3 5.9L10 14.4l-5.4 3 1.3-5.8-4.5-4.1 6-.5L10 1.5Z"/></svg>
          {t.hero.chipEstrella}
        </p>
        <p class="mt-0.5 text-xs text-ink-soft dark:text-white/75">{t.hero.chipEstrellaSub}</p>
      </div>
    </div>
  </div>

  <!-- Marquee de especialidades -->
  <div class="border-t border-teal-900/10 py-5 dark:border-white/10" aria-hidden="true">
    <div class="marquee">
      {
        [0, 1].map(() => (
          <div class="marquee-track">
            {t.especialidades.items.map((e) => (
              <span class="flex items-center gap-3 whitespace-nowrap text-sm font-medium uppercase tracking-[0.22em] text-ink-soft/80 dark:text-white/55">
                {e.nombre}
                <svg class="size-2.5 text-teal-500/60 dark:text-aqua-300/70" viewBox="0 0 10 10" fill="currentColor">
                  <circle cx="5" cy="5" r="5" />
                </svg>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Chips glass adaptativos */
  .hero-chip {
    background: rgb(255 255 255 / 0.7);
    border: 1px solid rgb(6 86 99 / 0.1);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }
  :global([data-theme='dark']) .hero-chip {
    background: rgb(255 255 255 / 0.1);
    border-color: rgb(255 255 255 / 0.18);
  }
</style>
