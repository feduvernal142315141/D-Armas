---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../layouts/Layout.astro';
import { clinica } from '../data/clinica';
import { useT, asLocale } from '../i18n';

const locale = asLocale(Astro.currentLocale);
const p = useT(locale).privacidad;
const version = import.meta.env.PUBLIC_PRIVACY_POLICY_VERSION;
---

<Layout title={p.metaTitle} description={p.metaDescription} ruta="/privacidad">
  <main class="mx-auto max-w-3xl px-5 py-16 sm:py-24 lg:px-8">
    <a href={getRelativeLocaleUrl(locale, '/')} class="link-under text-sm font-semibold text-teal-500">← {p.volver}</a>
    <p class="eyebrow mt-10">{clinica.nombre}</p>
    <h1 class="display mt-4 text-[clamp(2.2rem,5vw,3.4rem)]">{p.titulo}</h1>
    {version && <p class="mt-4 text-sm text-ink-soft">{p.version} {version}</p>}

    {
      p.secciones.map((seccion) => (
        <section class="mt-10">
          <h2 class="font-display text-xl font-medium">{seccion.titulo}</h2>
          {seccion.parrafos.map((parrafo) => (
            <p class="mt-3 leading-relaxed text-ink-soft">{parrafo}</p>
          ))}
        </section>
      ))
    }
  </main>
</Layout>
